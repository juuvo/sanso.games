---
// 手牌の絵。tiles は「123m567p234s689s11z」のような書き方 (数字の後ろに m 萬子・p 筒子・s 索子・z 字牌。字牌は
// 1 東・2 南・3 西・4 北・5 白・6 發・7 中。0 は赤5)。draw はツモ牌で、少しあけて右に置く。牌の絵はアプリと同じ
// (public/tiles)、牌の地と厚みは CSS (.tile)
interface Props {
  tiles: string;
  draw?: string;
  size?: 'large' | 'small' | 'thumb'; // thumb は記事の前後のリンクの小さな絵
  label?: string; // 読み上げ (無ければ牌の名前を並べる)
}

const HONORS = ['east', 'south', 'west', 'north', 'white', 'green', 'red'];
const HONOR_NAMES = ['東', '南', '西', '北', '白', '發', '中'];
const SUITS: Record<string, { file: string; name: string }> = {
  m: { file: 'man', name: '萬' },
  p: { file: 'pin', name: '筒' },
  s: { file: 'sou', name: '索' },
};

interface Tile {
  src: string;
  name: string;
}

function parseTiles(text: string): Tile[] {
  const tiles: Tile[] = [];
  let digits: string[] = [];
  for (const char of text.replace(/\s/g, '')) {
    if (/[0-9]/.test(char)) {
      digits.push(char);
      continue;
    }
    for (const digit of digits) {
      const number = Number(digit);
      if (char === 'z') {
        if (number < 1 || number > 7) throw new Error(`字牌は 1〜7: ${text}`);
        tiles.push({ src: `/tiles/${HONORS[number - 1]}.png`, name: HONOR_NAMES[number - 1] });
      } else if (SUITS[char]) {
        const suit = SUITS[char];
        const file = number === 0 ? `${suit.file}-5-red` : `${suit.file}-${number}`;
        tiles.push({ src: `/tiles/${file}.png`, name: `${number === 0 ? '赤5' : number}${suit.name}` });
      } else {
        throw new Error(`牌の書き方が違います: ${text}`);
      }
    }
    digits = [];
  }
  if (digits.length > 0) throw new Error(`最後に m・p・s・z が要ります: ${text}`);
  return tiles;
}

const { tiles, draw, size = 'large', label } = Astro.props;
const hand = parseTiles(tiles);
const drawn = draw ? parseTiles(draw) : [];
const spoken =
  label ??
  `${hand.map((tile) => tile.name).join(' ')}${drawn.length > 0 ? `、ツモ ${drawn.map((tile) => tile.name).join(' ')}` : ''}`;
---

<div class={`hand hand-${size}`} role="img" aria-label={spoken}>
  {
    hand.map((tile) => (
      <span class="tile">
        <span class="tile-face">
          <img src={tile.src} alt="" />
        </span>
      </span>
    ))
  }
  {
    drawn.map((tile) => (
      <span class="tile tile-drawn">
        <span class="tile-face">
          <img src={tile.src} alt="" />
        </span>
      </span>
    ))
  }
</div>
