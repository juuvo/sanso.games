---
import Base from '../layouts/Base.astro';
---

<Base title="サンソー - 何切る問題・牌効率トレーニング" header={false}>
  <main class="hero">
    <img class="hero-icon" src="/favicon.svg" alt="" width="128" height="128">
    <h1>サンソー</h1>
    <p class="hero-subtitle">何切る問題・牌効率トレーニング</p>
    <p class="hero-lead">配牌からツモ和了まで一人で打ち、切った牌を ◎○△✕ で判定する麻雀の練習アプリです。</p>
    <!-- id は App Store Connect の Apple ID。バッジは Apple の公式 (toolbox.marketingtools.apple.com) -->
    <a class="hero-store" href="https://apps.apple.com/jp/app/id6817753196">
      <picture>
        <source srcset="/app-store-badge-white.svg" media="(prefers-color-scheme: dark)">
        <img src="/app-store-badge-black.svg" alt="App Store からダウンロード" width="131" height="48">
      </picture>
    </a>
  </main>
</Base>
